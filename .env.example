# آدرس نهایی سایت — برای canonical، sitemap و og. بدون اسلش انتهایی.
# ⚠️ در زمان بیلد خوانده می‌شود، نه اجرا. بعد از تغییر باید دوباره بیلد کنید.
NEXT_PUBLIC_SITE_URL=https://psygstore.shop

# ─────────────────────────────────────────────────────────────────────
# لینک افیلیت: متغیر محیطی ندارد — عمداً.
#
# در افیلیو هر لینک یک `affid` یکتا دارد که سیستمشان موقع ساخت تولید
# می‌کند. با دو لینک واقعی تست شد: utm_source، utm_medium و utm_id ثابت
# می‌مانند ولی affid هر بار فرق می‌کند. یعنی هیچ «شناسه‌ی ناشر»ی وجود
# ندارد که بشود در یک متغیر گذاشت و از رویش لینک ساخت.
#
# به‌جایش، لینک آماده در فیلد `affiliateUrl` هر محصول ذخیره می‌شود.
# ─────────────────────────────────────────────────────────────────────

# وبهوک n8n برای ثبت ایمیل خبرنامه (فاز ۲)
N8N_SUBSCRIBE_WEBHOOK_URL=

# ─────────────────────────────────────────────────────────────────────
# وبهوک دستیار خرید هوشمند.
#
# ورک‌فلوی «21 · PSYG · Shopping Assistant» در n8n. آدرسش این شکلی است:
#     https://<آدرس-n8n>/webhook/psyg-assistant
#
# کلید هوش مصنوعی اینجا لازم نیست — ورک‌فلو از «00 · CORE · Bot AI
# Gateway» استفاده می‌کند که خودش بین ۲۴ کلید چرخش می‌کند.
#
# اگر خالی باشد، دستیار به کاربر می‌گوید در دسترس نیست. عمداً جواب
# از پیش نوشته برنمی‌گردانیم، چون کاربر فرقش را نمی‌فهمد و فکر می‌کند
# دارد با هوش مصنوعی حرف می‌زند.
# ─────────────────────────────────────────────────────────────────────
N8N_ASSISTANT_WEBHOOK_URL=

# ─────────────────────────────────────────────────────────────────────
# رمز پنل مدیریت (/admin).
#
# اگر خالی باشد، پنل کاملاً غیرفعال است — حالت امن پیش‌فرض. فراموش کردن
# تنظیم رمز نباید یعنی پنلی که هر کسی می‌تواند واردش شود.
#
# حداقل ۱۶ کاراکتر. با این دستور بساز:
#     openssl rand -base64 24
#
# ⚠️ در چت یا اسکرین‌شات نگذار. اگر لو رفت، عوضش کن و کانتینر را
#    ری‌استارت کن — همه‌ی نشست‌های باز هم باطل می‌شوند، چون کلید امضای
#    کوکی همین رمز است.
# ─────────────────────────────────────────────────────────────────────
PSYG_ADMIN_PASSWORD=

# ─────────────────────────────────────────────────────────────────────
# توکن اندپوینت محتوا — ورک‌فلوی تولید مقاله از آن استفاده می‌کند.
#
# ⚠️ این از PSYG_INGEST_TOKEN خطرناک‌تر است و باید جدا باشد.
#
# اندپوینت ingest هیچ بدنه‌ای نمی‌پذیرد — خودش می‌رود از افیلیو می‌خواند.
# ولی متن مقاله را مدل زبانی می‌نویسد و ناچار از بیرون می‌آید. یعنی این
# توکن اگر لو برود، کسی می‌تواند روی سایت مطلب منتشر کند.
#
# برای همین یکی نباشند: لو رفتن یکی نباید دیگری را باز کند.
#
# حداقل ۳۲ کاراکتر:  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────
PSYG_CONTENT_TOKEN=

# ─────────────────────────────────────────────────────────────────────
# توکن خواندن فهرست مشترکان خبرنامه.
#
# ⚠️ این حساس‌ترین توکن سایت است. خروجی‌اش نشانی ایمیل آدم‌های واقعی
# است — لو رفتنش یعنی فهرست ایمیل کاربران ما دست کسی که آن را برای
# اسپم می‌فروشد.
#
# برای همین جدا از PSYG_INGEST_TOKEN و PSYG_CONTENT_TOKEN است: لو
# رفتن آن دو نباید این را باز کند.
#
# اندپوینت فقط GET است؛ از آنجا نمی‌شود کسی را اضافه یا حذف کرد.
#
# حداقل ۳۲ کاراکتر:  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────
PSYG_SUBSCRIBERS_TOKEN=

# ─────────────────────────────────────────────────────────────────────
# گوگل سرچ کنسول — کد تأیید مالکیت.
#
# از Search Console → Add property → HTML tag می‌گیری. فقط مقدار
# `content` را اینجا بگذار، نه کل تگ.
#
# ⚠️ در زمان بیلد خوانده می‌شود، نه اجرا. بعد از تنظیمش باید دوباره
#    بیلد کنی وگرنه تگ در صفحه ظاهر نمی‌شود و تأیید گوگل شکست می‌خورد.
# ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# ─────────────────────────────────────────────────────────────────────
# گوگل آنالیتیکس — شناسه‌ی اندازه‌گیری، به شکل G-XXXXXXXXXX
#
# اگر خالی باشد هیچ اسکریپتی بارگذاری نمی‌شود. عمدی است: محیط توسعه
# نباید آمار را با بازدیدهای خودت آلوده کند.
#
# ⚠️ این هم در زمان بیلد خوانده می‌شود.
#
# نکته: افزودن آنالیتیکس یعنی داده‌ی بازدیدکننده به گوگل می‌رود. متن
# صفحه‌ی حریم خصوصی به‌همین‌خاطر به‌روز شده؛ اگر روزی این را برداشتی،
# آن متن را هم بردار.
# ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=

# ─────────────────────────────────────────────────────────────────────
# توکن اندپوینت MCP — برای اتصال هوش مصنوعی به سایت
#
# اگر خالی باشد، اندپوینت /api/mcp کاملاً غیرفعال است (حالت امن پیش‌فرض).
# حداقل ۳۲ کاراکتر. با این دستور بسازید:
#     openssl rand -hex 32
#
# ⚠️ این توکن مثل رمز عبور است. در چت عمومی یا اسکرین‌شات نگذارید.
#    اگر جایی لو رفت، مقدار جدید بسازید و کانتینر را ری‌استارت کنید.
# ─────────────────────────────────────────────────────────────────────
PSYG_MCP_TOKEN=

# ─────────────────────────────────────────────────────────────────────
# توکن اندپوینت ورود داده — فقط ورک‌فلوی n8n از آن استفاده می‌کند.
#
# اگر خالی باشد، /api/ingest کاملاً غیرفعال است (حالت امن پیش‌فرض).
# حداقل ۳۲ کاراکتر:  openssl rand -hex 32
#
# نکته‌ی مهم: این اندپوینت هیچ داده‌ای از بدنه‌ی درخواست نمی‌پذیرد —
# خودش می‌رود از افیلیو می‌خواند. پس حتی اگر توکن لو برود، مهاجم فقط
# می‌تواند باعث به‌روزرسانی زودهنگام شود، نه تزریق محتوا.
# ─────────────────────────────────────────────────────────────────────
PSYG_INGEST_TOKEN=

# مسیر ذخیره‌ی کاتالوگ و تاریخچه‌ی قیمت (در داکر روی volume مانت می‌شود)
PSYG_DATA_DIR=/data
